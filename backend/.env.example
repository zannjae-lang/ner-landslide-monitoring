# Environment Settings
PROJECT_NAME="NER Landslide Early Warning and Risk Monitoring System"
VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Server
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Database (Default: local SQLite database, or PostgreSQL)
DATABASE_URL="sqlite:///./ner_landslide.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ner_landslide"

# Model Artifact Paths
ARTIFACTS_DIR="artifacts"
MODEL1_ARTIFACT="models/model1_landslide_susceptibility.joblib"
MODEL2_ARTIFACT="models/model2_landslide_early_warning.joblib"
MODEL_REGISTRY="metadata/model_registry.json"
MODEL2_SCHEMA="schemas/model2_feature_schema.json"

# Risk Engine 2.0 Parameters
MAX_DATA_AGE_HOURS=6
RISK_SUSCEPTIBILITY_WEIGHT=0.45
RISK_DYNAMIC_WEIGHT=0.55
RISK_THRESHOLD_NORMAL=0.25
RISK_THRESHOLD_WATCH=0.25
RISK_THRESHOLD_ALERT=0.50
RISK_THRESHOLD_CRITICAL=0.75

# Rainfall Thresholds (24h)
RAINFALL_THRESHOLD_ELEVATED_MM=15.0
RAINFALL_THRESHOLD_HIGH_MM=35.0
RAINFALL_THRESHOLD_CRITICAL_MM=65.0

# External Data Providers & Flags
MOCK_PROVIDERS_ENABLED=True
AUTO_REFRESH_INTERVAL_MINUTES=30

# NASA Earthdata / GES DISC IMERG (Global Precipitation Measurement)
# Register at: https://urs.earthdata.nasa.gov/
# Generate token at: https://urs.earthdata.nasa.gov/users/tokens
NASA_EARTHDATA_TOKEN=""
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""
NASA_IMERG_API_KEY=""

# ISRO MOSDAC (Meteorological & Oceanographic Satellite Data Archival Centre)
# Register at: https://www.mosdac.gov.in/
MOSDAC_USER_ID=""
MOSDAC_USER_KEY=""
MOSDAC_API_KEY=""

# Google Earth Engine (GEE) Satellite Integration
# Set GEE_PROJECT_ID to your Google Cloud Project with Earth Engine API enabled.
# Or provide Service Account credentials for server-side auth.
GEE_PROJECT_ID="inlaid-reach-509012-c3"
GEE_SERVICE_ACCOUNT_EMAIL="gee-backend@inlaid-reach-509012-c3.iam.gserviceaccount.com"
GEE_PRIVATE_KEY_PATH="credentials/inlaid-reach-509012-c3-4af425befbb4.json"
